# WebSocket support for esp_http_server (required for /ws handler)
CONFIG_HTTPD_WS_SUPPORT=y

# ESP32-S3 production firmware runs the application CPU at its supported
# maximum frequency. Keep this in version control rather than relying on a
# developer's generated sdkconfig.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# We don't use TLS/HTTPS in the RC vehicle firmware, so the built-in certificate
# bundle is unnecessary. Disabling it also avoids generating/assembling the huge
# `x509_crt_bundle.S` during the build.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# Увеличиваем лимит сокетов LWIP: httpd (5 client + 2 internal) + DNS + UDP telem
CONFIG_LWIP_MAX_SOCKETS=16

# FreeRTOS tick rate 1000 Hz (1 мс/тик) — нужно для control loop 500 Гц (период 2 мс)
CONFIG_FREERTOS_HZ=1000

# app_main выполняет тяжелую C++ инициализацию (Wi-Fi/HTTP/vehicle control),
# поэтому увеличиваем стек main task, чтобы избежать stack overflow на старте.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Таблица разделов: приложение ~1.1 MB, раздел factory увеличен до 2 MB
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LOS-219/250: диагностика загрузки ядер (per-task/per-core CPU%) через
# uxTaskGetSystemState() — VehicleControlPlatformEsp32::LogCoreLoad().
# Клок статистики по умолчанию — esp_timer, доп. настройки не нужны.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
