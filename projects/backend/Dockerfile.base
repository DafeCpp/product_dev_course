# Build-base для backend-сервисов: компилятор, заголовки libpq и Poetry.
# Используется только builder-стадиями сервисов (services/*/Dockerfile): в финальные
# образы попадает лишь venv с prod-зависимостями, gcc/poetry туда не копируются.
FROM python:3.14-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Системные зависимости для сборки Python-пакетов с C-расширениями
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    g++ \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install poetry
RUN pip install --upgrade pip \
    && pip install poetry \
    && poetry config virtualenvs.create false

ARG BASE_IMAGE_HASH=""
LABEL org.opencontainers.image.base.dockerfile-hash=$BASE_IMAGE_HASH
