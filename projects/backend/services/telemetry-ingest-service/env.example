# Telemetry Ingest Service
ENV=development
HOST=0.0.0.0
PORT=8003
DB_POOL_SIZE=20

# Shared experiment DB (MVP)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/experiment_db

# CORS origins (mostly irrelevant for device ingest, but kept for consistency)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Per-sensor ingest rate limiting (fixed window). 0 = unlimited for that counter.
# REST: 600 req / 60s = 10 req/s sustained per sensor (matches simulator 10 Hz).
REST_RATE_LIMIT_REQUESTS_PER_WINDOW=600
REST_RATE_LIMIT_READINGS_PER_WINDOW=60000
REST_RATE_LIMIT_WINDOW_SECONDS=60
# WebSocket ingest limits
WS_RATE_LIMIT_MESSAGES_PER_WINDOW=600
WS_RATE_LIMIT_READINGS_PER_WINDOW=60000
WS_RATE_LIMIT_WINDOW_SECONDS=1

