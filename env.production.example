# Production Environment (Yandex Cloud)
#
# Скопируйте на сервер: /opt/experiment-tracking/.env
# ВНИМАНИЕ: содержит секреты, не коммитьте в git!

# --- Container Registry ---
CR_REGISTRY=cr.yandex/YOUR_REGISTRY_ID
IMAGE_TAG=latest

# --- PostgreSQL (Yandex Managed) ---
# Хост: terraform output pg_cluster_host
# ВНИМАНИЕ: базы данных и пользователи (auth_db, experiment_db, config_db, script_db) должны быть
# созданы заранее в Managed PostgreSQL (Terraform). Миграции применяют one-shot сервисы
# auth-migrate / experiment-migrate / config-migrate / script-migrate на каждом деплое (идемпотентно).
AUTH_DATABASE_URL=postgresql://auth_user:PASSWORD@c-CLUSTER.rw.mdb.yandexcloud.net:6432/auth_db?sslmode=verify-full
EXPERIMENT_DATABASE_URL=postgresql://experiment_user:PASSWORD@c-CLUSTER.rw.mdb.yandexcloud.net:6432/experiment_db?sslmode=verify-full
CONFIG_DATABASE_URL=postgresql://config_user:PASSWORD@c-CLUSTER.rw.mdb.yandexcloud.net:6432/config_db?sslmode=verify-full
SCRIPT_DATABASE_URL=postgresql://script_user:PASSWORD@c-CLUSTER.rw.mdb.yandexcloud.net:6432/script_db?sslmode=verify-full
CONFIG_SERVICE_DB_POOL_SIZE=10

# --- Auth Service ---
JWT_SECRET=GENERATE_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=1209600
BCRYPT_ROUNDS=12

# --- Auth Proxy (BFF) ---
COOKIE_DOMAIN=your-domain.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# CORS
CORS_ORIGINS=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GRAFANA_ROOT_URL=http://your-domain.com:3001

# --- DB Pool ---
AUTH_SERVICE_DB_POOL_SIZE=20
EXPERIMENT_SERVICE_DB_POOL_SIZE=20
TELEMETRY_INGEST_DB_POOL_SIZE=20
SCRIPT_SERVICE_DB_POOL_SIZE=10

# --- Internal runtime services ---
# Redis is reachable only from the Compose app network; do not publish port 6379.
REDIS_URL=redis://redis:6379/0
TELEMETRY_BROKER_URL=redis://redis:6379/0

# --- Object Storage (experiment-service artifacts) ---
# Values come from Terraform outputs. Never commit real static keys.
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_PUBLIC_ENDPOINT_URL=https://storage.yandexcloud.net
S3_ACCESS_KEY=CHANGE_ME_TERRAFORM_OUTPUT_ARTIFACTS_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_TERRAFORM_OUTPUT_ARTIFACTS_S3_SECRET_KEY
S3_BUCKET=YOUR_ARTIFACTS_BUCKET_NAME
S3_PRESIGN_EXPIRE_SECONDS=3600

# telemetry-ingest-service config client contract
CONFIG_CLIENT_ENABLED=true
CONFIG_CLIENT_URL=http://config-service:8005
CONFIG_CLIENT_POLL_INTERVAL_SECONDS=5.0
